includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - config
        - database
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    ignoreErrors:
        # This is the package's own config file: env() is the right call here
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/eloquentize.php
